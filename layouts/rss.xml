{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pages := .RegularPages }}
{{- if .IsHome }}{{ $pages = where .Site.RegularPages "Section" "articles" }}{{ end }}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if .IsHome }}{{ .Site.Title }}{{ else }}{{ .Title }} - {{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default .Site.Params.description }}</description>
    <language>{{ .Site.Language.Locale | default .Site.Language.Lang }}</language>
    <managingEditor>{{ .Site.Params.email }} ({{ .Site.Params.author }})</managingEditor>
    <webMaster>{{ .Site.Params.email }} ({{ .Site.Params.author }})</webMaster>
    <copyright>CC BY 4.0, {{ now.Year }} {{ .Site.Params.author }}</copyright>
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{- end }}
    {{- with $pages }}{{ with (index . 0).Date }}
    <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}{{ end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <description>{{ .Description | default .Summary | plainify }}</description>
      {{- /* Escaped rather than wrapped in CDATA: an article body that
             contains the sequence "]]>" would close the section early and
             produce a feed no reader can parse. */}}
      <content:encoded>{{ .Content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
