# Local overrides for `hugo` and `wrangler`. Copy to `.env` and adjust.
# `.env` is gitignored; nothing here is a secret.

# Public origin. Overrides baseURL from hugo.toml, useful for preview builds.
HUGO_BASEURL=https://kevinallioli.com/

# Commit stamped into the footer and the colophon. CI sets this to the SHA
# of the commit being built; locally, `make build` derives it from git.
HUGO_PARAMS_BUILDCOMMIT=dev

# Cloudflare project the site is published to.
CLOUDFLARE_PROJECT_NAME=kevinallioli-com

# --- Secrets, never stored in this file --------------------------------------
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID live in the GitHub repository
# secrets and are injected by the deploy workflow. Do not put them here, and do
# not export them from a shell profile.
